# Copy to a private deployment directory as .env (chmod 600).
# These are references, not credential values. Create paths/files before start.
GENESIS_UID=502
GENESIS_GID=20
# Verify socket GID INSIDE a Linux container; do not use macOS stat output.
GENESIS_DOCKER_GID=0
GENESIS_DATA_ROOT=/Users/ianphil/.local/state/genesis-durable
GENESIS_SECRET_DIR=/Users/ianphil/.config/genesis-durable
# Pre-pull a published immutable digest, then use docker image inspect --format '{{.Id}}'.
# Provisioner requires a bare local image ID, independently of provisioner :latest.
GENESIS_AGENT_IMAGE=sha256:REPLACE
GENESIS_NAMESPACE=mac-mini
GENESIS_MODEL_URL=http://100.85.128.83:4000
GENESIS_GATEWAY_URL=http://100.85.128.83:4000
GENESIS_GATEWAY_TEAM_ID=045b989a-4ed3-4492-b7a4-ca1884cd876f
GENESIS_INGRESS_URL=http://REPLACE_TAILSCALE_IP:19901
